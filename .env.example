# Postgres. On Vercel use the Neon *pooled* connection string.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/declassic

# Auth.js. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=change-me
# Only needed when not on Vercel, so Auth.js trusts the host header.
AUTH_TRUST_HOST=true

# Public URL of the site, used for SEO, sitemap and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (image uploads). Without these, uploads are saved to /public/uploads in development only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=de-classic

# Resend (new request email alerts). Without a key, alerts are logged to the server console.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "De Classic <bookings@declassic.ng>".
EMAIL_FROM=De Classic Hotel <onboarding@resend.dev>

# First owner account, created by `npm run db:seed`.
SEED_OWNER_EMAIL=owner@declassic.ng
SEED_OWNER_PASSWORD=change-me-now
SEED_OWNER_NAME=Hotel owner
